{
  "expo": {
    "name": "Livadra",
    "slug": "livadra",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.livadra.app"
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#C4956A"
      },
      "package": "com.livadra.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "splash": {
      "backgroundColor": "#121110"
    },
    "plugins": [
      "expo-secure-store",
      "expo-av",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "2ed15a57-9df6-400a-900f-5e6cb1c1da34"
      }
    },
    "owner": "zabir94"
  }
}
