# Local development only. This file (.env) is gitignored and is NOT uploaded to EAS.
# Point at your machine's LAN IP so a phone on the same Wi-Fi can reach the local backend.
EXPO_PUBLIC_API_URL=http://YOUR_MACHINE_LAN_IP:8000

# Production builds do NOT read this file. Set the URL in the EAS "production" environment:
#   eas env:create --environment production --name EXPO_PUBLIC_API_URL --value https://api.livadra.com --visibility plaintext
# app.config.js fails any EAS production build whose URL is missing, http://, localhost, or a private IP.
